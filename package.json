{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @ai-gateway/api dev",
    "dev:web": "pnpm --filter @ai-gateway/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @ai-gateway/api test",
    "test:e2e": "node tests/run-e2e.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "docker:up": "docker compose --profile full up -d --build",
    "docker:down": "docker compose --profile full down",
    "prisma:generate": "pnpm --filter @ai-gateway/api prisma:generate",
    "prisma:migrate": "pnpm --filter @ai-gateway/api prisma:migrate",
    "prisma:studio": "pnpm --filter @ai-gateway/api prisma:studio",
    "seed": "pnpm --filter @ai-gateway/api prisma:seed",
    "cleanup": "pnpm --filter @ai-gateway/api prisma:cleanup",
    "audit:models": "node scripts/model-audit.mjs",
    "verify:status": "node tools/verify/channel-status.mjs",
    "verify:probe": "node tools/verify/channel-probe.mjs",
    "verify:residue": "node tools/verify/residue-check.mjs",
    "verify:deploy": "node tools/verify/deploy-acceptance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "react-doctor": "^0.9.14",
    "typescript-eslint": "^8.71.0"
  }
}
