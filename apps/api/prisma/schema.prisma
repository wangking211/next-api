generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  balance      Decimal    @default(0) @db.Decimal(18, 6)
  /// 用户价倍率（相对渠道价）：用户价 = 渠道价 × 倍率；为空时继承所属代理的倍率，代理也为空则 1
  priceMultiplier Decimal? @db.Decimal(6, 4)
  /// 代理返点比例（0-1）：其名下用户消耗的积分按此比例返给该代理
  rebateRate      Decimal? @db.Decimal(6, 4)
  /// 所属代理/分销商（role=AGENT 的用户）
  agentId      String?
  agent        User?      @relation("AgentMembers", fields: [agentId], references: [id], onDelete: SetNull)
  members      User[]     @relation("AgentMembers")
  /// 所属模型分组（决定可见模型与分组倍率）；null = 默认分组
  groupId      String?
  group        ModelGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  /// 最后活跃（最近一次网关调用/登录）：物化自 RequestLog，用于列表按活跃时间排序
  lastActiveAt DateTime?
  /// 令牌版本：「退出全部设备」/强制下线时 +1，使已签发的 JWT 立即失效（对应 `tv` claim）
  tokenVersion Int      @default(0)

  apiKeys     ApiKey[]
  channels    Channel[]
  logs        RequestLog[]
  usage       UsageDaily[]
  balanceTxs  BalanceTransaction[]
  withdrawals WithdrawalRequest[]
  payments    PaymentOrder[]

  @@index([lastActiveAt])
  // 代理/分销维度：按 agentId 聚合名下成员（overview/members 的关系过滤走这里）
  @@index([agentId])
  // 分组维度：按 groupId 筛选/统计用户
  @@index([groupId])
  // 管理端按创建时间倒序分页
  @@index([createdAt])
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(18, 6)
  status       WithdrawalStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum BalanceTxType {
  RECHARGE
  CONSUME
  ADJUST
  COMMISSION
  TRANSFER
  WITHDRAW
  /// 渠道共享收益（渠道主把自有渠道上架给他人使用后按实收分成入账）
  CHANNEL_REVENUE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model BalanceTransaction {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BalanceTxType
  amount       Decimal       @db.Decimal(18, 6)
  balanceAfter Decimal       @db.Decimal(18, 6)
  description  String?
  operatorId   String?
  requestLogId String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum RedeemCodeStatus {
  UNUSED
  USED
  DISABLED
}

model RedeemCode {
  id          String           @id @default(uuid())
  code        String           @unique
  amount      Decimal          @db.Decimal(18, 6)
  status      RedeemCodeStatus @default(UNUSED)
  batchId     String?
  note        String?
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([batchId])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CLOSED
  FAILED
}

/// 在线充值订单（微信/支付宝，经 JAIPay 网关）
model PaymentOrder {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 商户订单号（提交给 JAIPay，全局唯一）
  mchOrderNo     String             @unique
  /// JAIPay 订单号
  payOrderId     String?
  /// 支付方式代码：QR_CASHIER / WX_NATIVE / ALI_QR 等
  wayCode        String
  /// 渠道代码：alipay / wxpay
  channel        String?
  /// 渠道订单号（支付宝/微信交易号）
  channelOrderNo String?
  /// 充值金额（人民币分，最小 100 = 1 元）
  amountCents    Int
  /// 入账额度（USD）= amountCents / 100 / PAY_CNY_PER_USD
  creditUsd      Decimal            @db.Decimal(18, 6)
  /// 入账积分快照（= creditUsd × CREDITS_PER_USD，用于对账展示）
  credits        Decimal            @db.Decimal(18, 2)
  status         PaymentOrderStatus @default(PENDING)
  paidAt         DateTime?
  /// 回调原文（审计用）
  notifyRaw      String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  method     String?
  path       String?
  statusCode Int?
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// 智能路由策略（评分权重预设，留空则回退 ROUTING_STRATEGY 环境变量）
enum RoutingStrategy {
  BALANCED
  CHEAPEST
  FASTEST
  STABLE
  QUALITY_FIRST
}

model ApiKey {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String       @unique
  keyPrefix String
  status    ApiKeyStatus @default(ACTIVE)

  quotaLimit Int?
  quotaUsed  Int      @default(0)
  costLimit  Decimal? @db.Decimal(18, 6)
  costUsed   Decimal  @default(0) @db.Decimal(18, 6)
  rpmLimit   Int?
  /// 该 Key 的智能路由策略；为空用全局默认（ROUTING_STRATEGY）
  routingStrategy RoutingStrategy?
  /// TPM（每分钟 token 数）上限；null = 不限制
  tpmLimit   Int?
  /// 模型白名单（支持别名与 :latest）；空数组 = 不限制
  models     String[] @default([])
  /// 令牌级分组覆盖（优先级高于用户所属分组）；null = 用用户分组
  groupId    String?
  group      ModelGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs  RequestLog[]
  usage UsageDaily[]

  @@index([userId, createdAt]) // 复合索引前缀已覆盖 userId-only 查询
}

enum ChannelOwnerType {
  PLATFORM
  USER
}

enum ChannelStatus {
  ENABLED
  DISABLED
}

/// 渠道共享模式：决定自有渠道是否/如何开放给他人使用
enum ChannelShareMode {
  /// 私有：仅持有者可见（默认）
  PRIVATE
  /// 同分组共享：绑定分组内的用户可见
  GROUP
  /// 公开共享：所有用户可见
  PUBLIC
}

/// 共享紧急度：额度/时间快用不完时提高派发优先级的诉求
enum ChannelShareUrgency {
  NORMAL
  HIGH
  FLUSH
}

model Channel {
  id          String           @id @default(uuid())
  ownerType   ChannelOwnerType
  ownerUserId String?
  owner       User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  provider    String
  baseUrl     String
  apiKeyEnc   String
  models      String[]
  /// 渠道分组（多对多）：未配分组的渠道为公共渠道，任何分组均可见
  groups      ModelGroup[]     @relation("ChannelGroups")
  /// 上游接入地：DOMESTIC=国内直连，OVERSEAS=海外中转；null = 未标注
  region      ModelOrigin?
  /// 上游计费分组名（如 TokenFleet 的 group_test），仅用于成本核算与展示
  upstreamGroup String?
  /// 共享模式（仅自有渠道有意义）：PRIVATE 私有 / GROUP 同分组共享 / PUBLIC 公开共享
  shareMode   ChannelShareMode @default(PRIVATE)
  /// 平台抽成基点（1/10000），仅管理员可设；null = 用全局默认 CHANNEL_SHARE_FEE_BPS
  shareFeeBps Int?
  /// —— 本轮共享目标（达到任一项即自动停止接单，适合「把本月用不完的额度烧掉」）——
  /// 折算上游成本上限 USD：以渠道成本价（costInput/costOutput）累计，最贴合「用掉多少额度」
  shareQuotaCostUsd Decimal? @db.Decimal(18, 6)
  /// 调用次数上限
  shareQuotaRequests Int?
  /// 到期时间（到时自动停止接单）
  shareUntil DateTime?
  /// 共享紧急度：NORMAL 常态 / HIGH 加急 / FLUSH 清仓（额度快过期时提高派发优先级）
  shareUrgency ChannelShareUrgency @default(NORMAL)
  /// 本轮已被他人消耗的折算成本（热路径同事务累加）
  shareUsedCostUsd Decimal @default(0) @db.Decimal(18, 6)
  /// 本轮已被他人调用的次数
  shareUsedRequests Int @default(0)
  /// 累计共享分成收益（渠道主实收 USD：热路径同事务累加，列表页 O(1) 读取，免逐请求聚合）
  shareRevenue Decimal @default(0) @db.Decimal(18, 6)
  weight      Int              @default(1)
  priority    Int              @default(0)
  status      ChannelStatus    @default(ENABLED)
  failureCount Int             @default(0)
  autoDisabled Boolean         @default(false)
  lastErrorAt  DateTime?
  lastErrorMsg String?
  /// 每日调用限额（自然日，默认 UTC+8）；null/0 = 不限。超限后智能路由排除该渠道
  dailyRequestLimit Int?
  /// 每日 token 限额（prompt+completion）；null/0 = 不限
  dailyTokenLimit    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logs RequestLog[]
  modelPrices ChannelModel[]

  @@index([ownerUserId])
  @@index([ownerType, status])
}

/// 渠道 × 模型 的定价配置（同一模型可由多个上游提供，价格/折扣各异）
model ChannelModel {
  id          String   @id @default(uuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  modelName   String
  /// 上游真实模型名（对外规范名 → 上游名映射）；为空则用 modelName 原样请求上游
  upstreamModelName String?
  /// 上游成本 USD/1M tokens（用于按成本路由与毛利统计）
  costInput   Decimal? @db.Decimal(18, 6)
  costOutput  Decimal? @db.Decimal(18, 6)
  /// 对用户售价 USD/1M tokens；为空时用 ModelCatalog 默认价 × discount
  priceInput  Decimal? @db.Decimal(18, 6)
  priceOutput Decimal? @db.Decimal(18, 6)
  /// 按次成本 / 按次售价（USD/次）：图片等非 token 计费模型；为空时回退目录 perCallPrice
  costPerCall  Decimal? @db.Decimal(18, 6)
  pricePerCall Decimal? @db.Decimal(18, 6)
  /// 折扣系数（0.8 = 八折），作用于官方价；显式 price 存在时忽略
  discount      Decimal? @db.Decimal(6, 4)
  /// 上游成本折扣率（0.3 = 成本为官方价的 30%）
  costDiscount  Decimal? @db.Decimal(6, 4)
  /// 下游售价折扣率（0.5 = 售价为官方价的 50%）
  priceDiscount Decimal? @db.Decimal(6, 4)
  enabled     Boolean  @default(true)
  /// 覆盖渠道优先级/权重（可选）
  priority    Int?
  weight      Int?
  /// L1 人工质量分 0~2（1=正常）。官方直连 1.0、可用中转 0.85、疑似降智/蒸馏 0.6 等；参与智能路由评分
  qualityScore Decimal @default(1) @db.Decimal(4, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, modelName])
  @@index([modelName, enabled])
}

model ModelCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  provider    String
  /// 模型产地：DOMESTIC=国产，OVERSEAS=海外。默认海外（漏标的国产模型只会少暴露，不会误放行海外模型）
  origin      ModelOrigin @default(OVERSEAS)
  /// 厂商规范名（openai / anthropic / google / deepseek / moonshot / zhipu / alibaba / minimax / kuaishou / xai …）
  vendor      String?
  inputPrice  Decimal  @default(0) @db.Decimal(18, 6)
  outputPrice Decimal  @default(0) @db.Decimal(18, 6)
  cacheReadPrice  Decimal @default(0) @db.Decimal(18, 6)
  cacheWritePrice Decimal @default(0) @db.Decimal(18, 6)
  /// 按次售价（USD/次）：图片等非 token 计费模型；null = 走 token 计价
  perCallPrice    Decimal? @db.Decimal(18, 6)
  /// 能力标签（vision / tools / reasoning / json_mode 等）；空数组 = 未标注，能力检查放行
  capabilities String[] @default([])
  /// 别名列表：请求这些名字时解析到本模型（name 为规范名）
  aliases      String[] @default([])
  /// 可见该模型的模型分组（多对多）；未加入任何分组 = 所有分组可见
  groups       ModelGroup[] @relation("ModelGroupModels")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ModelGroupStatus {
  ENABLED
  DISABLED
}

/// 模型产地：DOMESTIC=国产模型，OVERSEAS=海外模型（合规判断以模型产地为准）
enum ModelOrigin {
  DOMESTIC
  OVERSEAS
}

/// 模型分组：一组可见模型 + 分组倍率。用户/令牌绑定分组后决定其可见模型与价格档位
model ModelGroup {
  id          String           @id @default(uuid())
  name        String           @unique
  displayName String
  description String?
  /// 分组倍率（作用在渠道用户价之上）：为空 = 不参与，回退用户/代理倍率
  ratio       Decimal?         @db.Decimal(6, 4)
  status      ModelGroupStatus @default(ENABLED)
  /// 展示/路由优先级（越大越靠前）
  priority    Int              @default(0)
  /// 默认分组：未指定分组的用户归属（全局仅一个，由服务层保证）
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  /// 该分组可见的模型（多对多）；空 = 不限制（全部模型可见）
  models   ModelCatalog[] @relation("ModelGroupModels")
  users    User[]
  apiKeys  ApiKey[]
  /// 归属该分组的渠道（多对多）；渠道未配分组 = 公共
  channels Channel[]      @relation("ChannelGroups")

  @@index([status, priority])
}

model RequestLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  model            String
  provider         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  upstreamCost     Decimal  @default(0) @db.Decimal(18, 6)
  /// 本次调用是否实际扣费：平台渠道 true；用户自有 BYOK 渠道 false（此时 cost 仅为折算金额，不进余额）
  chargeable       Boolean  @default(true)
  /// 本次调用支付给各级代理的返点合计（USD）
  commission       Decimal  @default(0) @db.Decimal(18, 6)
  /// 本次调用支付给渠道主的分成（共享渠道，USD）；平台留存 = chargeable 实收 − 本值
  channelRevenue   Decimal  @default(0) @db.Decimal(18, 6)
  /// 本次调用生效的售价倍率与来源（user / group / agent / default），用于账单审计
  multiplierApplied Decimal? @db.Decimal(6, 4)
  multiplierSource  String?
  latencyMs        Int?
  status           Int      @default(200)
  errorMessage     String?
  isStream         Boolean  @default(false)
  requestPreview   String?  @db.Text
  responsePreview  String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model UsageDaily {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  date             DateTime @db.Date
  requests         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 折算总额（含 BYOK 未计费的调用），用于毛利/用量分析
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  /// 实际扣费金额（仅 chargeable 的调用），与余额扣款同口径
  billedCost       Decimal  @default(0) @db.Decimal(18, 6)

  @@unique([userId, apiKeyId, date])
  @@index([userId, date])
  @@index([apiKeyId, date])
  // 管理端按日期维度聚合（不带 userId 过滤）走这里
  @@index([date])
}
