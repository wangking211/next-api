generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  balance      Decimal    @default(0) @db.Decimal(18, 6)
  /// 用户价倍率（相对渠道价）：用户价 = 渠道价 × 倍率；为空时继承所属代理的倍率，代理也为空则 1
  priceMultiplier Decimal? @db.Decimal(6, 4)
  /// 代理返点比例（0-1）：其名下用户消耗的积分按此比例返给该代理
  rebateRate      Decimal? @db.Decimal(6, 4)
  /// 所属代理/分销商（role=AGENT 的用户）
  agentId      String?
  agent        User?      @relation("AgentMembers", fields: [agentId], references: [id], onDelete: SetNull)
  members      User[]     @relation("AgentMembers")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apiKeys     ApiKey[]
  channels    Channel[]
  logs        RequestLog[]
  usage       UsageDaily[]
  balanceTxs  BalanceTransaction[]
  withdrawals WithdrawalRequest[]
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(18, 6)
  status       WithdrawalStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum BalanceTxType {
  RECHARGE
  CONSUME
  ADJUST
  COMMISSION
  TRANSFER
  WITHDRAW
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model BalanceTransaction {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BalanceTxType
  amount       Decimal       @db.Decimal(18, 6)
  balanceAfter Decimal       @db.Decimal(18, 6)
  description  String?
  operatorId   String?
  requestLogId String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum RedeemCodeStatus {
  UNUSED
  USED
  DISABLED
}

model RedeemCode {
  id          String           @id @default(uuid())
  code        String           @unique
  amount      Decimal          @db.Decimal(18, 6)
  status      RedeemCodeStatus @default(UNUSED)
  batchId     String?
  note        String?
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([batchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  method     String?
  path       String?
  statusCode Int?
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

model ApiKey {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String       @unique
  keyPrefix String
  status    ApiKeyStatus @default(ACTIVE)

  quotaLimit Int?
  quotaUsed  Int      @default(0)
  costLimit  Decimal? @db.Decimal(18, 6)
  costUsed   Decimal  @default(0) @db.Decimal(18, 6)
  rpmLimit   Int?

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs  RequestLog[]
  usage UsageDaily[]

  @@index([userId])
}

enum ChannelOwnerType {
  PLATFORM
  USER
}

enum ChannelStatus {
  ENABLED
  DISABLED
}

model Channel {
  id          String           @id @default(uuid())
  ownerType   ChannelOwnerType
  ownerUserId String?
  owner       User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  provider    String
  baseUrl     String
  apiKeyEnc   String
  models      String[]
  weight      Int              @default(1)
  priority    Int              @default(0)
  status      ChannelStatus    @default(ENABLED)
  failureCount Int             @default(0)
  autoDisabled Boolean         @default(false)
  lastErrorAt  DateTime?
  lastErrorMsg String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logs RequestLog[]
  modelPrices ChannelModel[]

  @@index([ownerUserId])
  @@index([ownerType, status])
}

/// 渠道 × 模型 的定价配置（同一模型可由多个上游提供，价格/折扣各异）
model ChannelModel {
  id          String   @id @default(uuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  modelName   String
  /// 上游成本 USD/1M tokens（用于按成本路由与毛利统计）
  costInput   Decimal? @db.Decimal(18, 6)
  costOutput  Decimal? @db.Decimal(18, 6)
  /// 对用户售价 USD/1M tokens；为空时用 ModelCatalog 默认价 × discount
  priceInput  Decimal? @db.Decimal(18, 6)
  priceOutput Decimal? @db.Decimal(18, 6)
  /// 折扣系数（0.8 = 八折），作用于官方价；显式 price 存在时忽略
  discount      Decimal? @db.Decimal(6, 4)
  /// 上游成本折扣率（0.3 = 成本为官方价的 30%）
  costDiscount  Decimal? @db.Decimal(6, 4)
  /// 下游售价折扣率（0.5 = 售价为官方价的 50%）
  priceDiscount Decimal? @db.Decimal(6, 4)
  enabled     Boolean  @default(true)
  /// 覆盖渠道优先级/权重（可选）
  priority    Int?
  weight      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, modelName])
  @@index([modelName, enabled])
}

model ModelCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  provider    String
  inputPrice  Decimal  @default(0) @db.Decimal(18, 6)
  outputPrice Decimal  @default(0) @db.Decimal(18, 6)
  cacheReadPrice  Decimal @default(0) @db.Decimal(18, 6)
  cacheWritePrice Decimal @default(0) @db.Decimal(18, 6)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RequestLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  model            String
  provider         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  upstreamCost     Decimal  @default(0) @db.Decimal(18, 6)
  /// 本次调用支付给各级代理的返点合计（USD）
  commission       Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs        Int?
  status           Int      @default(200)
  errorMessage     String?
  isStream         Boolean  @default(false)
  requestPreview   String?  @db.Text
  responsePreview  String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model UsageDaily {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  date             DateTime @db.Date
  requests         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)

  @@unique([userId, apiKeyId, date])
  @@index([userId, date])
  @@index([apiKeyId, date])
}
