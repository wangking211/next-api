generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  balance      Decimal    @default(0) @db.Decimal(18, 6)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apiKeys     ApiKey[]
  channels    Channel[]
  logs        RequestLog[]
  usage       UsageDaily[]
  balanceTxs  BalanceTransaction[]
}

enum BalanceTxType {
  RECHARGE
  CONSUME
  ADJUST
}

model BalanceTransaction {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BalanceTxType
  amount       Decimal       @db.Decimal(18, 6)
  balanceAfter Decimal       @db.Decimal(18, 6)
  description  String?
  operatorId   String?
  requestLogId String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum RedeemCodeStatus {
  UNUSED
  USED
  DISABLED
}

model RedeemCode {
  id          String           @id @default(uuid())
  code        String           @unique
  amount      Decimal          @db.Decimal(18, 6)
  status      RedeemCodeStatus @default(UNUSED)
  batchId     String?
  note        String?
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([batchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  method     String?
  path       String?
  statusCode Int?
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

model ApiKey {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String       @unique
  keyPrefix String
  status    ApiKeyStatus @default(ACTIVE)

  quotaLimit Int?
  quotaUsed  Int      @default(0)
  costLimit  Decimal? @db.Decimal(18, 6)
  costUsed   Decimal  @default(0) @db.Decimal(18, 6)
  rpmLimit   Int?

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs  RequestLog[]
  usage UsageDaily[]

  @@index([userId])
}

enum ChannelOwnerType {
  PLATFORM
  USER
}

enum ChannelStatus {
  ENABLED
  DISABLED
}

model Channel {
  id          String           @id @default(uuid())
  ownerType   ChannelOwnerType
  ownerUserId String?
  owner       User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  provider    String
  baseUrl     String
  apiKeyEnc   String
  models      String[]
  weight      Int              @default(1)
  priority    Int              @default(0)
  status      ChannelStatus    @default(ENABLED)
  failureCount Int             @default(0)
  autoDisabled Boolean         @default(false)
  lastErrorAt  DateTime?
  lastErrorMsg String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logs RequestLog[]

  @@index([ownerUserId])
  @@index([ownerType, status])
}

model ModelCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  provider    String
  inputPrice  Decimal  @default(0) @db.Decimal(18, 6)
  outputPrice Decimal  @default(0) @db.Decimal(18, 6)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RequestLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  model            String
  provider         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs        Int?
  status           Int      @default(200)
  errorMessage     String?
  isStream         Boolean  @default(false)
  requestPreview   String?  @db.Text
  responsePreview  String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model UsageDaily {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  date             DateTime @db.Date
  requests         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)

  @@unique([userId, apiKeyId, date])
  @@index([userId, date])
  @@index([apiKeyId, date])
}
