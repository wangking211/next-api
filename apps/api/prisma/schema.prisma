generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AGENT
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  balance      Decimal    @default(0) @db.Decimal(18, 6)
  /// 用户价倍率（相对渠道价）：用户价 = 渠道价 × 倍率；为空时继承所属代理的倍率，代理也为空则 1
  priceMultiplier Decimal? @db.Decimal(6, 4)
  /// 代理返点比例（0-1）：其名下用户消耗的积分按此比例返给该代理
  rebateRate      Decimal? @db.Decimal(6, 4)
  /// 所属代理/分销商（role=AGENT 的用户）
  agentId      String?
  agent        User?      @relation("AgentMembers", fields: [agentId], references: [id], onDelete: SetNull)
  members      User[]     @relation("AgentMembers")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  apiKeys     ApiKey[]
  channels    Channel[]
  logs        RequestLog[]
  usage       UsageDaily[]
  balanceTxs  BalanceTransaction[]
  withdrawals WithdrawalRequest[]
  payments    PaymentOrder[]
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(18, 6)
  status       WithdrawalStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum BalanceTxType {
  RECHARGE
  CONSUME
  ADJUST
  COMMISSION
  TRANSFER
  WITHDRAW
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model BalanceTransaction {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BalanceTxType
  amount       Decimal       @db.Decimal(18, 6)
  balanceAfter Decimal       @db.Decimal(18, 6)
  description  String?
  operatorId   String?
  requestLogId String?
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

enum RedeemCodeStatus {
  UNUSED
  USED
  DISABLED
}

model RedeemCode {
  id          String           @id @default(uuid())
  code        String           @unique
  amount      Decimal          @db.Decimal(18, 6)
  status      RedeemCodeStatus @default(UNUSED)
  batchId     String?
  note        String?
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([batchId])
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CLOSED
  FAILED
}

/// 在线充值订单（微信/支付宝，经 JAIPay 网关）
model PaymentOrder {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 商户订单号（提交给 JAIPay，全局唯一）
  mchOrderNo     String             @unique
  /// JAIPay 订单号
  payOrderId     String?
  /// 支付方式代码：QR_CASHIER / WX_NATIVE / ALI_QR 等
  wayCode        String
  /// 渠道代码：alipay / wxpay
  channel        String?
  /// 渠道订单号（支付宝/微信交易号）
  channelOrderNo String?
  /// 充值金额（人民币分，最小 100 = 1 元）
  amountCents    Int
  /// 入账额度（USD）= amountCents / 100 / PAY_CNY_PER_USD
  creditUsd      Decimal            @db.Decimal(18, 6)
  /// 入账积分快照（= creditUsd × CREDITS_PER_USD，用于对账展示）
  credits        Decimal            @db.Decimal(18, 2)
  status         PaymentOrderStatus @default(PENDING)
  paidAt         DateTime?
  /// 回调原文（审计用）
  notifyRaw      String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String
  method     String?
  path       String?
  statusCode Int?
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// 智能路由策略（评分权重预设，留空则回退 ROUTING_STRATEGY 环境变量）
enum RoutingStrategy {
  BALANCED
  CHEAPEST
  FASTEST
  STABLE
  QUALITY_FIRST
}

model ApiKey {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String       @unique
  keyPrefix String
  status    ApiKeyStatus @default(ACTIVE)

  quotaLimit Int?
  quotaUsed  Int      @default(0)
  costLimit  Decimal? @db.Decimal(18, 6)
  costUsed   Decimal  @default(0) @db.Decimal(18, 6)
  rpmLimit   Int?
  /// 该 Key 的智能路由策略；为空用全局默认（ROUTING_STRATEGY）
  routingStrategy RoutingStrategy?
  /// TPM（每分钟 token 数）上限；null = 不限制
  tpmLimit   Int?
  /// 模型白名单（支持别名与 :latest）；空数组 = 不限制
  models     String[] @default([])

  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  logs  RequestLog[]
  usage UsageDaily[]

  @@index([userId])
}

enum ChannelOwnerType {
  PLATFORM
  USER
}

enum ChannelStatus {
  ENABLED
  DISABLED
}

model Channel {
  id          String           @id @default(uuid())
  ownerType   ChannelOwnerType
  ownerUserId String?
  owner       User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  provider    String
  baseUrl     String
  apiKeyEnc   String
  models      String[]
  weight      Int              @default(1)
  priority    Int              @default(0)
  status      ChannelStatus    @default(ENABLED)
  failureCount Int             @default(0)
  autoDisabled Boolean         @default(false)
  lastErrorAt  DateTime?
  lastErrorMsg String?
  /// 每日调用限额（自然日，默认 UTC+8）；null/0 = 不限。超限后智能路由排除该渠道
  dailyRequestLimit Int?
  /// 每日 token 限额（prompt+completion）；null/0 = 不限
  dailyTokenLimit    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logs RequestLog[]
  modelPrices ChannelModel[]

  @@index([ownerUserId])
  @@index([ownerType, status])
}

/// 渠道 × 模型 的定价配置（同一模型可由多个上游提供，价格/折扣各异）
model ChannelModel {
  id          String   @id @default(uuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  modelName   String
  /// 上游成本 USD/1M tokens（用于按成本路由与毛利统计）
  costInput   Decimal? @db.Decimal(18, 6)
  costOutput  Decimal? @db.Decimal(18, 6)
  /// 对用户售价 USD/1M tokens；为空时用 ModelCatalog 默认价 × discount
  priceInput  Decimal? @db.Decimal(18, 6)
  priceOutput Decimal? @db.Decimal(18, 6)
  /// 折扣系数（0.8 = 八折），作用于官方价；显式 price 存在时忽略
  discount      Decimal? @db.Decimal(6, 4)
  /// 上游成本折扣率（0.3 = 成本为官方价的 30%）
  costDiscount  Decimal? @db.Decimal(6, 4)
  /// 下游售价折扣率（0.5 = 售价为官方价的 50%）
  priceDiscount Decimal? @db.Decimal(6, 4)
  enabled     Boolean  @default(true)
  /// 覆盖渠道优先级/权重（可选）
  priority    Int?
  weight      Int?
  /// L1 人工质量分 0~2（1=正常）。官方直连 1.0、可用中转 0.85、疑似降智/蒸馏 0.6 等；参与智能路由评分
  qualityScore Decimal @default(1) @db.Decimal(4, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([channelId, modelName])
  @@index([modelName, enabled])
}

model ModelCatalog {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  provider    String
  inputPrice  Decimal  @default(0) @db.Decimal(18, 6)
  outputPrice Decimal  @default(0) @db.Decimal(18, 6)
  cacheReadPrice  Decimal @default(0) @db.Decimal(18, 6)
  cacheWritePrice Decimal @default(0) @db.Decimal(18, 6)
  /// 能力标签（vision / tools / reasoning / json_mode 等）；空数组 = 未标注，能力检查放行
  capabilities String[] @default([])
  /// 别名列表：请求这些名字时解析到本模型（name 为规范名）
  aliases      String[] @default([])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RequestLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  model            String
  provider         String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  upstreamCost     Decimal  @default(0) @db.Decimal(18, 6)
  /// 本次调用是否实际扣费：平台渠道 true；用户自有 BYOK 渠道 false（此时 cost 仅为折算金额，不进余额）
  chargeable       Boolean  @default(true)
  /// 本次调用支付给各级代理的返点合计（USD）
  commission       Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs        Int?
  status           Int      @default(200)
  errorMessage     String?
  isStream         Boolean  @default(false)
  requestPreview   String?  @db.Text
  responsePreview  String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([channelId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model UsageDaily {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId         String?
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  date             DateTime @db.Date
  requests         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// 折算总额（含 BYOK 未计费的调用），用于毛利/用量分析
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  /// 实际扣费金额（仅 chargeable 的调用），与余额扣款同口径
  billedCost       Decimal  @default(0) @db.Decimal(18, 6)

  @@unique([userId, apiKeyId, date])
  @@index([userId, date])
  @@index([apiKeyId, date])
}
