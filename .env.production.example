# 生产环境变量示例。复制为 .env（已被 .gitignore 忽略）后填入真实值。
#   cp .env.production.example .env
#
# 同时加载两个 compose 文件，避免只加载基础文件导致生产配置丢失
# （端口对外暴露、api 使用开发库密码）。设置后可直接执行 `docker compose --profile full up -d`。
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- 必填（docker-compose.prod.yml 用 :? 强校验，缺失会拒绝启动）----
# 数据库超级用户密码（仅内部访问）
POSTGRES_PASSWORD=
# 会话签名密钥：openssl rand -base64 48
JWT_SECRET=
# 渠道密钥加密密钥，32 字节 hex：openssl rand -hex 32
ENCRYPTION_KEY=
# 首次初始化创建的管理员密码（存在管理员后不再生效）
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 运行环境 ----
NODE_ENV=production
BOOTSTRAP_ADMIN_EMAIL=admin@aigw.local
BOOTSTRAP_ADMIN_USERNAME=admin
# 允许的前端来源，逗号分隔
CORS_ORIGIN=https://xiaopuyun.com,https://www.xiaopuyun.com

# ---- 可选 ----
# 平台 API Key 的额外 pepper（留空则不加盐）
API_KEY_PEPPER=
# 积分 / 费用换算：1 美元 = 多少积分
CREDITS_PER_USD=100
# 代理返点模式：stacked | differential
REBATE_MODE=stacked
# 渠道连通性测试单次最多测试的模型数
TEST_MAX_MODELS=100
# 默认每分钟请求数上限（0 表示不限）
DEFAULT_RPM=0
