# 生产环境变量示例。复制为 .env（已被 .gitignore 忽略）后填入真实值。
#   cp .env.production.example .env
#
# 同时加载两个 compose 文件，避免只加载基础文件导致生产配置丢失
# （端口对外暴露、api 使用开发库密码）。设置后可直接执行 `docker compose --profile full up -d`。
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#
# 说明：api 服务通过 `env_file: .env` 读取本文件（见 docker-compose.yml），
# 但 compose 的 `environment:` 显式白名单优先级更高（DATABASE_URL / JWT_SECRET /
# ENCRYPTION_KEY / NODE_ENV / 代理相关），因此下面这些键不会覆盖容器关键配置。
# 新增变量后需重启 api 容器：docker compose up -d api

# ---- 必填（docker-compose.prod.yml 用 :? 强校验，缺失会拒绝启动）----
# 数据库超级用户密码（仅内部访问）
POSTGRES_PASSWORD=
# 会话签名密钥：openssl rand -base64 48
JWT_SECRET=
# 渠道密钥加密密钥，32 字节 hex：openssl rand -hex 32
ENCRYPTION_KEY=
# 首次初始化创建的管理员密码（存在管理员后不再生效）
BOOTSTRAP_ADMIN_PASSWORD=

# ---- 运行环境 ----
NODE_ENV=production
BOOTSTRAP_ADMIN_EMAIL=admin@aigw.local
BOOTSTRAP_ADMIN_USERNAME=admin
# 冒烟测试第 9 节（domestic 分组镜像一致性）的管理登录：填现役凭据。
# 引导密码改过之后 BOOTSTRAP_ADMIN_* 会失效，此键优先；缺省回退引导值，两者皆无则该检查 skip。
SMOKE_ADMIN_IDENTIFIER=admin
SMOKE_ADMIN_PASSWORD=
# 允许的前端来源，逗号分隔
CORS_ORIGIN=https://xiaopuyun.com,https://www.xiaopuyun.com
# API 监听端口（compose 内固定 3000，一般无需改）
PORT=3000
# 反向代理链信任：true / false / 跳数 / 网段。生产默认 172.16.0.0/12（docker 网段），
# 直连端口伪造的 XFF 因来源不在网段内不被采信
TRUST_PROXY=172.16.0.0/12
# JWT 有效期（默认 7d）
JWT_EXPIRES_IN=7d

# ---- 安全与限流 ----
# 平台 API Key 的额外 pepper（留空则不加盐；建议生产启用，启用后新 Key 用 HMAC-SHA256）
API_KEY_PEPPER=
# API Key 前缀（默认 sk-；仅新建 Key 生效）
API_KEY_PREFIX=sk-
# 登录失败限流：次数 / 窗口秒数
LOGIN_FAIL_LIMIT=10
LOGIN_FAIL_WINDOW=300
# 登录 IP 限流：次数 / 窗口秒数（防撞库）
LOGIN_IP_LIMIT=30
LOGIN_IP_WINDOW=300

# ---- 邮件通道（注册邮箱验证码 / 找回密码）----
# 配置 SMTP_HOST 即启用：注册强制邮箱验证码 + 开放「忘记密码」。
# 留空 = 未启用：注册保持免验证码，「忘记密码」返回 AUTH_MAIL_NOT_CONFIGURED。
SMTP_HOST=
SMTP_PORT=465
# 是否隐式 SSL；不填按端口推断（465=true，其余=false）
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI Gateway <no-reply@xiaopuyun.com>"
# 万能开关：false 时即使配了 SMTP_HOST 也不启用
MAIL_ENABLED=true
# 验证码有效期（秒）/ 重发冷却（秒）/ 校验失败几次后作废
MAIL_CODE_TTL_SECONDS=600
MAIL_CODE_COOLDOWN_SECONDS=60
MAIL_CODE_MAX_ATTEMPTS=5
# 发码 IP 限流：次数 / 窗口秒数
MAIL_IP_LIMIT=20
MAIL_IP_WINDOW=300

# ---- 计费与代理 ----
# 积分 / 费用换算：1 美元 = 多少积分
CREDITS_PER_USD=100
# 代理返点模式：stacked | differential
REBATE_MODE=stacked
# 网关预授权默认最大输出 tokens（用于余额预估上限）
PREAUTH_MAX_OUTPUT_TOKENS=4096
# 默认每分钟请求数上限（0 表示不限；单 Key 可用 rpmLimit 覆盖）
DEFAULT_RPM=0
# 控制台 /api 每 IP 每窗口请求上限（0 关闭；Redis 故障时自动放行）
CONSOLE_RATE_LIMIT=600
# 控制台限流窗口秒数
CONSOLE_RATE_WINDOW=60

# ---- 在线充值（JAIPay：微信/支付宝）----
# 商户号 / 应用 ID / 应用密钥（JAIPay 管理端获取；三项齐全才开通在线支付）
JAIPAY_MCH_NO=
JAIPAY_APP_ID=
JAIPAY_APP_SECRET=
# 网关地址与回调/返回地址（留空用默认值）
JAIPAY_BASE_URL=https://pay.zxixing.com
JAIPAY_NOTIFY_URL=https://xiaopuyun.com/api/pay/jai/notify
JAIPAY_RETURN_URL=https://xiaopuyun.com/billing
# 充值汇率：1 美元 = ? 元人民币（决定「充值 N 元到账多少积分」）
# 留空 = 自动获取实时汇率（成功结果缓存 6 小时）；填写数字 = 固定汇率（覆盖实时值）
PAY_CNY_PER_USD=
# 实时汇率接口（返回 JSON 的 rates.CNY）/ 缓存时长 / 超时
# 默认 exchangerate-api 免费端点；亦可换 https://api.frankfurter.app/latest?from=USD&to=CNY（ECB）
PAY_RATE_API_URL=https://open.er-api.com/v6/latest/USD
PAY_RATE_TTL_MS=21600000
PAY_RATE_TIMEOUT_MS=5000

# ---- 内容记录与流式 ----
# 是否记录请求/响应内容（生产建议 false：涉及用户隐私且显著减少磁盘占用）
LOG_CONTENT=false
# 单条内容最大保存字符数
LOG_CONTENT_MAX=20000
# 请求日志保留天数（0 = 不清理；生产建议 180，应用内每日分批删除过期 RequestLog）
REQUEST_LOG_RETENTION_DAYS=0
# 清理周期（毫秒，默认 24h）
REQUEST_LOG_RETENTION_INTERVAL_MS=86400000
# API 文档 /api/docs（生产默认关闭，暴露全量 API 结构；需要时设 true）
SWAGGER_ENABLED=false
# 流式空闲超时（毫秒）
STREAM_IDLE_TIMEOUT_MS=120000

# ---- 渠道与网关 ----
# 渠道连通性测试单次最多测试的模型数
TEST_MAX_MODELS=100
# 连续失败达到该次数自动禁用渠道
CHANNEL_FAILURE_THRESHOLD=5
# 自动禁用渠道的复查间隔（毫秒），到点自动重试恢复
CHANNEL_AUTO_REENABLE_MS=600000
# 渠道自动禁用/限流时推送的告警 webhook（留空则不推送）
ALERT_WEBHOOK_URL=
# 允许渠道 Base URL 指向内网地址（默认禁止；仅自建内网上游时才开启，有 SSRF 风险）
ALLOW_PRIVATE_UPSTREAM=false

# ---- 智能路由（评分 / 熔断 / 每日限额）----
# 全局默认路由策略：BALANCED | CHEAPEST | FASTEST | STABLE | QUALITY_FIRST
ROUTING_STRATEGY=BALANCED
# 会话粘性开关 / 前置得分比阈值
ROUTING_STICKY=true
ROUTING_STICKY_RATIO=0.8
# 粘性时间窗轮换（毫秒，默认 30min）：到点换哈希桶，避免热点渠道长期独占
ROUTING_STICKY_ROTATE_MS=1800000
# 粘性负载占比门：实际负载 > 权重占比 × 该倍数时放弃粘性（0 = 关闭）
ROUTING_STICKY_LOAD_GATE=2
# 成本评分权重平滑系数 tau（0 = 完全按绝对成本，越大越偏向权重抽签）
ROUTING_WEIGHT_TAU=0.1
# 单请求总时长上限（毫秒），超时对客户端返回 deadline_exceeded
GATEWAY_DEADLINE_MS=300000
# 渠道目录缓存 TTL（毫秒）
CATALOG_CACHE_TTL_MS=60000
# 指标滑窗 / 快照缓存 / Redis 故障退避（毫秒）
ROUTING_METRICS_WINDOW_MS=600000
ROUTING_METRICS_TTL_MS=5000
ROUTING_METRICS_RETRY_MS=10000
# 打印路由评分日志（排障用）
ROUTING_DEBUG=false
# 模型级熔断：连续失败阈值 / 冷却时长 / 冷却上限（429 退避封顶）
CHANNEL_MODEL_FAILURE_THRESHOLD=3
CHANNEL_MODEL_COOLDOWN_MS=60000
CHANNEL_MODEL_COOLDOWN_MAX_MS=600000
# 429 首次冷却时长（指数退避基数）
CHANNEL_RATE_LIMIT_BASE_MS=30000
# 每日限额的自然日切分偏移（小时，默认 UTC+8）
CHANNEL_LIMIT_DAY_OFFSET_HOURS=8

# ---- 观测（健康看门狗 / Prometheus 指标）----
# 周期探活 DB/Redis + 证书到期预警，异常/恢复推 ALERT_WEBHOOK_URL（false 关闭）
WATCHDOG_ENABLED=true
# 首检延迟 / 健康检查周期 / 证书检查周期（毫秒）
WATCHDOG_INITIAL_DELAY_MS=30000
WATCHDOG_HEALTH_INTERVAL_MS=300000
WATCHDOG_CERT_INTERVAL_MS=21600000
# 证书到期预警：探测 host:port 与剩余天数阈值
CERT_CHECK_HOST=xiaopuyun.com
CERT_CHECK_PORT=443
CERT_EXPIRY_WARN_DAYS=14
# Prometheus 抓取 /api/metrics 的鉴权 token（留空：生产禁用，开发开放）
METRICS_TOKEN=
